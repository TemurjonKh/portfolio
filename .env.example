# Postgres. On Vercel: Storage → Create → Neon; it sets both variables for you.
# Locally, paste the same Neon URL into both.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Public site address, used for reset links and SEO. Optional on Vercel (falls back to the production domain).
NEXTAUTH_URL="http://localhost:3000"

# Creates the owner account on first deploy only. 12+ characters.
ADMIN_INITIAL_PASSWORD="set-a-strong-one-time-seed-password"

# Uploads. On Vercel: Storage → Create → Blob; it sets this for you. Leave empty locally.
BLOB_READ_WRITE_TOKEN=""

# Contact form + password reset (Resend).
EMAIL_FROM="Temurjon Portfolio <portfolio@example.com>"
EMAIL_PROVIDER_API_KEY="re_xxxxxxxxx"
